/**
 * Same deployment as wrangler.jsonc but named for the "media26" Workers
 * Builds project (Workers Builds requires the config's name to match the
 * project's Worker name). To use it, set that project's deploy command to:
 *
 *   npx wrangler deploy --config wrangler.media26.jsonc
 *
 * If the media26 project is just a duplicate of smarteriptv, deleting it in
 * the Cloudflare dashboard is the simpler option.
 */
{
  "name": "media26",
  "main": "_worker.js",
  "compatibility_date": "2025-06-01",
  /* Must mirror wrangler.jsonc — see the note there. Each Worker project gets its OWN Durable
     Object storage, so whichever project is actually serving customers is the one whose store
     holds their codes; running both is how a code activated on one host goes missing on the
     other. Deleting the duplicate project remains the right cleanup. */
  "durable_objects": {
    "bindings": [
      { "name": "LICENSES", "class_name": "LicenseStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LicenseStore"] }
  ],
  "vars": {
    "TRANSCODER_ORIGIN": "https://media26-transcoder-production-f0b9.up.railway.app"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
